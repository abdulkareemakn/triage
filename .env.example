# Copy to .env at the repository root for local development. Never commit .env.
# Node loads this file; Zod validates it when the server starts.

# Application
NODE_ENV=development
PORT=3001
# Internal Express port used by Vite's development proxy.
API_PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/mern
# Public browser origin; use the same value for both URLs.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required in production when sending email through Resend.
RESEND_API_KEY=
# Optional: comma-separated IPs/CIDRs of your actual reverse proxy. Empty trusts none.
TRUST_PROXY=

# RustFS: local dev only, do not use these values or credentials in production.
# The API runs on the host; Compose maps these credentials to RustFS.
# Create mern-local once in http://localhost:9001 (see Development workflow).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mern-local
STORAGE_ACCESS_KEY_ID=mern-local-dev
STORAGE_SECRET_ACCESS_KEY=mern-local-dev-secret-only
# Production uses separate private buckets and credentials:
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com, region: auto
# B2 endpoint: https://s3.<region>.backblazeb2.com, region: your bucket's region
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Tests: required by integration and E2E tests; never falls back to MONGODB_URI.
# Tests add and remove a random database name on this dedicated server.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017

# Docker Compose: publish the app on this host port.
APP_PORT=3000
